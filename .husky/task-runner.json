{
    "$schema": "https://alirezanet.github.io/Husky.Net/schema.json",
    "tasks": [
        {
            "name": "dotnet-format-staged-files",
            "group": "pre-commit-operations",
            "command": "dotnet",
            "args": [ "format", "SFC.Bff.sln", "--verbosity", "diagnostic", "--include", "${staged}" ],
            "include": [ "**/*.cs" ]
        },
        {
            "name": "dotnet-build",
            "group": "pre-commit-operations",
            "command": "dotnet",
            "args": [ "build", "SFC.Bff.sln", "--no-restore", "--configuration", "Release" ]
        },
        {
            "name": "dotnet-test",
            "group": "pre-push-operations",
            "command": "dotnet",
            "args": [ "test", "SFC.Bff.sln", "--no-restore", "--no-build", "/p:CollectCoverage=true", "/p:CoverletOutput=../coverage/code_coverage", "/p:CoverletOutputFormat=opencover", "/p:Threshold=0", "/p:ThresholdStat=total" ]
        },
        {
            "name": "dotnet-reportgenerator-create",
            "group": "pre-push-operations",
            "command": "reportgenerator",
            "args": [ "-reports:tests/coverage/code_coverage.opencover.xml", "-targetdir:tests/coverage/report", "-reporttypes:Html", "-assemblyfilters:+SFC.Bff.Domain;+SFC.Bff.Application;+SFC.Bff.Infrastructure;+SFC.Backend" ]
        },
        {
            "name": "npm-lint",
            "group": "pre-commit-operations",
            "command": "npm",
            "cwd": "src/Frontend/SFC.Frontend",
            "args": [ "run", "lint:all" ]
        },
        {
            "name": "npm-build",
            "group": "pre-commit-operations",
            "command": "npm",
            "cwd": "src/Frontend/SFC.Frontend",
            "args": [ "run", "build" ]
        },
        {
            "name": "npm-test",
            "group": "pre-push-operations",
            "command": "npm",
            "cwd": "src/Frontend/SFC.Frontend",
            "args": [ "run", "test:code-coverage:no-browser" ]
        }
    ]
}
