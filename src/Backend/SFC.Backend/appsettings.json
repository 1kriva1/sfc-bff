{
    "Logging": {
        "LogLevel": {
            "Default": "Information",
            "Microsoft.AspNetCore": "Warning"
        }
    },
    "AllowedHosts": "*",
    "Kestrel": {
        "Endpoints": {
            "Http": {
                "Url": "http://+:7165",
                "Protocols": "Http1"
            },
            "Https": {
                "Url": "https://+:7166",
                "Protocols": "Http1"
            }
        },
        "Certificates": {
            "Default": {
                "Path": "/https/sfc-bff.pfx",
                "Password": "Test1234!"
            }
        }
    },
    "Bff": {
        "Authority": "https://sfc-identity:7266",
        "ClientId": "sfc",
        "ClientSecret": "secret_sfc",
        "CallbackPath": "/signin-oidc",
        "SignedOutCallbackPath": "/signout-callback-oidc",
        "Scopes": [ "openid", "profile", "offline_access" ],
        "Apis": [
            {
                "LocalPath": "/api/data",
                "RemoteUrl": "https://sfc-data:7466/api/data",
                "RequiredToken": "User",
                "TokenExchange": {
                    "ClientId": "sfc.data",
                    "ClientSecret": "secret_sfc_data",
                    "Scopes": "sfc.data.full"
                }
            },
            {
                "LocalPath": "/api/players",
                "RemoteUrl": "https://sfc-player:7366/api/players",
                "RequiredToken": "User",
                "TokenExchange": {
                    "ClientId": "sfc.player",
                    "ClientSecret": "secret_sfc_player",
                    "Scopes": "sfc.player.full"
                }
            },
            {
                "LocalPath": "/api/teams",
                "RemoteUrl": "https://sfc-team:7566/api/teams",
                "RequiredToken": "User",
                "TokenExchange": {
                    "ClientId": "sfc.team",
                    "ClientSecret": "secret_sfc_team",
                    "Scopes": "sfc.team.full"
                }
            },
            {
                "LocalPath": "/api/invites",
                "RemoteUrl": "https://sfc-invite:7666/api/invites",
                "RequiredToken": "User",
                "TokenExchange": {
                    "ClientId": "sfc.invite",
                    "ClientSecret": "secret_sfc_invite",
                    "Scopes": "sfc.invite.full"
                }
            },
            {
                "LocalPath": "/api/requests",
                "RemoteUrl": "https://sfc-request:7766/api/requests",
                "RequiredToken": "User",
                "TokenExchange": {
                    "ClientId": "sfc.request",
                    "ClientSecret": "secret_sfc_request",
                    "Scopes": "sfc.request.full"
                }
            },
            {
                "LocalPath": "/api/schemes",
                "RemoteUrl": "https://sfc-scheme:7866/api/schemes",
                "RequiredToken": "User",
                "TokenExchange": {
                    "ClientId": "sfc.scheme",
                    "ClientSecret": "secret_sfc_scheme",
                    "Scopes": "sfc.scheme.full"
                }
            },
            {
                "LocalPath": "/api/identity",
                "RemoteUrl": "https://sfc-identity:7266/api/identity",
                "RequiredToken": "User",
                "TokenExchange": {
                    "ClientId": "sfc.identity",
                    "ClientSecret": "secret_sfc_identity",
                    "Scopes": "sfc.identity.full"
                }
            }
        ]
    }
}
